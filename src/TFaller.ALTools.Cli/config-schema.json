{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "projectPath": {
            "type": "string",
            "description": "Location of the project folder. Can be ommited if the config file is in the project folder."
        },
        "transformations": {
            "type": "object",
            "additionalProperties": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [
                                "comment-transform-var",
                                "comment-transform-param",
                                "comment-transform-cond",
                                "comment-query-sync",
                                "complex-return-transpiler",
                                "complex-return-uplifter",
                                "temp-blob-uplifter",
                                "implicit-rec-fixer",
                                "table-field-renamer"
                            ]
                        },
                        "tags": {
                            "type": "string"
                        },
                        "tables": {
                            "type": "array",
                            "description": "Only for table-field-renamer: tables and their fields to rename and/or renumber. Declarations (tables, table extensions) and references are updated. Fields not listed are ignored.",
                            "items": {
                                "type": "object",
                                "required": ["name", "fields"],
                                "additionalProperties": false,
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "Name of the table"
                                    },
                                    "fields": {
                                        "type": "object",
                                        "description": "Current field name -> change",
                                        "additionalProperties": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "properties": {
                                                "name": {
                                                    "type": "string",
                                                    "description": "New field name"
                                                },
                                                "no": {
                                                    "type": "integer",
                                                    "description": "New field number"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "flags": {
                            "type": "object",
                            "description": "Only for comment-transform-cond: flags usable in @altools:transform:<tag>:cond:if:<flag>. true keeps the block, false removes it.",
                            "additionalProperties": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        }
    }
}